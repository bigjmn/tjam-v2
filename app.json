{
	"expo": {
		"scheme": "triojamapp",
		"name": "triojam",
		"slug": "triojam",
		"version": "3.1.0",
		"orientation": "portrait",
		"icon": "./assets/trioicon.png",
		"userInterfaceStyle": "light",
		"newArchEnabled": true,
		"splash": {
			"image": "./assets/trioicon.png",
			"resizeMode": "contain",
			"backgroundColor": "#ffffff"
		},
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.JNicks.TrioJam",
			"usesAppleSignIn": true,
			"infoPlist": {
				"ITSAppUsesNonExemptEncryption": false,
				"CFBundleURLTypes": [
					{
						"CFBundleURLSchemes": [
							"com.googleusercontent.apps.69866138009-ife8ui5n34uhgur4mqcsmjeol5s4o9nl"
						]
					}
				]
			}
		},
		"android": {
			"package": "com.triojam.app",
			"adaptiveIcon": {
				"foregroundImage": "./assets/adaptive-icon.png",
				"backgroundColor": "#ffffff"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"favicon": "./assets/favicon.png"
		},
		"plugins": ["expo-router", "expo-audio", "expo-apple-authentication"],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "9770b0c7-3e80-4abc-bd19-63f2b94ff94d"
			}
		}
	}
}
